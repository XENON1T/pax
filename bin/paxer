#!/usr/bin/env python
""" Processor for Analyzing XENON - command line interface """

from pax import core
import multiprocessing
import logging
import queue

if __name__ == '__main__':
    args, override_string = core.get_user_configuration()
    p2 = core.Processor(config_names=args.config,
                        config_paths=args.config_path,
                        config_string=override_string)

    events_input = multiprocessing.Queue(100)
    events_output = multiprocessing.Queue()

    # The worker thread pulls an item from the queue and processes it
    def worker(events_input, events_output):
        my_p = core.Processor(config_names=args.config,
                              config_paths=args.config_path,
                              config_string=override_string,
                              output=False)
        while True:
            event = events_input.get()
            event = my_p.process_event(event)
            events_output.put(event)



    # Create the queue and thread pool.
    for i in range(4):
         t = multiprocessing.Process(target=worker,
                                     args=(events_input, events_output))
         t.daemon = True  # thread dies when main thread (only non-daemon thread) exits.
         t.start()


    event_generator = p2.get_events()
    i = 0
    j = 0
    while True:
        try:
            event = next(event_generator)
        except StopIteration:
            break

        try:
            logging.info("Feeding event %d to input queue" % i)
            events_input.put_nowait(event)
            i += 1
            event = next(event_generator)
        except queue.Empty:
            print('except')

        try:
            logging.info("Retrieving %dth event from output queue" % j)
            event = events_output.get_nowait()
            j += 1
            p2.write_event(event)
        except queue.Empty:
            logging.info("except")
    else:
        while (not events_input.empty()) or (not events_output.empty()):
            logging.info("Retrieving %dth event from output queue" % i)
            event = events_output.get()
            j += 1
            p2.write_event(event)


